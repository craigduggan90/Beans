{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-header": "Release PR",
  "pull-request-footer": " ",
  "packages": {
    "src/Beans.Patchable": {
      "component": "Beans.Patchable",
      "pull-request-title-pattern": "chore(release): release patchable ${version}",
      "extra-files": [
        {
          "type": "xml",
          "path": "Beans.Patchable/Beans.Patchable.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ]
    },
    "src/Beans.Common": {
      "component": "Beans.Common",
      "pull-request-title-pattern": "chore(release): release common ${version}",
      "extra-files": [
        {
          "type": "xml",
          "path": "Beans.Common/Beans.Common.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ]
    },
    "src/Beans.Requestable": {
      "component": "Beans.Requestable",
      "pull-request-title-pattern": "chore(release): release requestable ${version}",
      "extra-files": [
        {
          "type": "xml",
          "path": "Beans.Requestable/Beans.Requestable.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ]
    }
  }
}
